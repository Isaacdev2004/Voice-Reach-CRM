{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/assistant-production-readiness": false,
      "feat/myari-concierge": false,
      "feat/premium-auth-refresh": false,
      "release/luxury-mortgage-pdf-2": false,
      "feat/public-feature-workflow": false,
      "feat/contacts-csv-export": false,
      "fix/mortgage-pdf-field-overflow": false,
      "fix/settings-brand-pdf-recovery": false,
      "feat/premium-assistant-workspace": false,
      "feat/notes-writing-studio": false
    }
  },
  "crons": [
    {
      "path": "/api/campaigns/runner",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/dashboard/briefing/runner",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "app/api/campaigns/runner/route.ts": {
      "maxDuration": 60
    },
    "app/api/campaigns/[campaignId]/send/route.ts": {
      "maxDuration": 60
    },
    "app/api/webhooks/voice/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
