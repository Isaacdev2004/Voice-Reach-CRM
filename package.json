{
  "name": "voicereach-backend-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "dev:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-test.mjs",
    "test:contacts-metrics": "node --import tsx scripts/contacts-metrics.test.ts",
    "test:security": "node scripts/verify-audit-fixes.mjs",
    "test:unit": "node --import tsx scripts/verify-unit.ts && npm run test:contacts-metrics && npm run test:contacts-workspace && npm run test:property-finder && npm run test:campaign-library",
    "test:regressions": "node --import tsx scripts/verify-regressions.ts",
    "test:contacts-workspace": "node --import tsx scripts/contacts-workspace.test.ts && node scripts/contacts-routes.test.cjs",
    "test:contacts-browser": "node scripts/contacts-browser.test.cjs",
    "test:property-finder": "node --import tsx scripts/property-finder.test.ts",
    "test:property-finder-browser": "node scripts/property-finder-browser.test.cjs",
    "test:campaign-library": "node --import tsx scripts/campaign-library.test.ts && node scripts/campaign-library-routes.test.cjs",
    "test:campaign-library-browser": "node scripts/campaign-library-browser.test.cjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "@clerk/ui": "^1.25.7",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.2.6",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "utf-8-validate": "^5.0.10"
  }
}
