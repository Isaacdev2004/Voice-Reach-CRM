{
  "name": "voicereach-backend-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "dev:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-test.mjs",
    "test:contacts-metrics": "node --import tsx scripts/contacts-metrics.test.ts",
    "test:security": "node scripts/verify-audit-fixes.mjs",
    "test:unit": "node --import tsx scripts/verify-unit.ts && npm run test:contacts-metrics && npm run test:contacts-workspace && npm run test:property-finder && npm run test:campaign-library && npm run test:campaign-audit && npm run test:delivery && npm run test:calendar && npm run test:notes && npm run test:financing && npm run test:tasks && npm run test:studio-audit && npm run test:settings-audit && npm run test:dashboard && npm run test:communications && npm run test:public-marketing && node scripts/pricing-billing.test.cjs && npm run test:campaign-premium && npm run test:assistant && npm run test:ai-pricing && npm run test:assistant-messaging && npm run test:concierge",
    "test:regressions": "node --import tsx scripts/verify-regressions.ts",
    "test:contacts-workspace": "node --import tsx scripts/contacts-workspace.test.ts && node scripts/contacts-routes.test.cjs",
    "test:contacts-browser": "node scripts/contacts-browser.test.cjs",
    "test:property-finder": "node --import tsx scripts/property-finder.test.ts && node scripts/property-finder-routes.test.cjs",
    "test:property-finder-browser": "node scripts/property-finder-browser.test.cjs",
    "test:campaign-library": "node --import tsx scripts/campaign-library.test.ts && node scripts/campaign-library-routes.test.cjs",
    "test:campaign-library-browser": "node scripts/campaign-library-browser.test.cjs",
    "test:campaign-audit": "node scripts/campaign-delivery-audit.test.cjs",
    "audit:campaign-report": "node --import tsx scripts/campaign-audit/report.ts",
    "test:delivery": "node --import tsx scripts/delivery-analytics.test.ts && node scripts/delivery-routes.test.cjs",
    "test:delivery-browser": "node scripts/delivery-browser.test.cjs",
    "test:calendar": "node scripts/calendar-workspace.test.cjs",
    "test:calendar-browser": "node scripts/calendar-browser.test.cjs",
    "test:notes": "node scripts/notes-workspace.test.cjs",
    "test:notes-db": "node scripts/notes-database.test.cjs",
    "test:notes-browser": "node scripts/notes-browser.test.cjs",
    "test:financing": "node --import tsx scripts/financing.test.ts && node scripts/financing-routes.test.cjs",
    "test:financing-browser": "node scripts/financing-browser.test.cjs",
    "test:financing-db": "node scripts/financing-database.test.cjs",
    "test:tasks": "node --import tsx scripts/tasks.test.ts && node scripts/tasks-routes.test.cjs",
    "test:tasks-db": "node scripts/tasks-database.test.cjs",
    "test:tasks-browser": "node scripts/tasks-browser.test.cjs",
    "test:studio-audit": "node scripts/studio-audit.test.cjs && node scripts/voice-drafts.test.cjs",
    "test:settings-audit": "node scripts/settings-audit.test.cjs",
    "test:studio-db": "node scripts/studio-database.test.cjs",
    "test:studio-browser": "node scripts/studio-browser.test.cjs",
    "test:dashboard": "node scripts/dashboard-display.test.cjs && node scripts/dashboard-briefing.test.cjs",
    "test:dashboard-browser": "node scripts/dashboard-review.test.cjs",
    "test:voice-repair-browser": "node scripts/voice-repair-browser.test.cjs",
    "test:communications": "node scripts/twilio-communications.test.cjs",
    "test:calendar-db": "node scripts/calendar-database.test.cjs",
    "test:public-marketing": "node --import tsx scripts/public-marketing.test.ts && node scripts/public-contact.test.cjs && node scripts/public-playbook.test.cjs && node scripts/public-capture-assets.test.cjs",
    "test:public-browser": "node scripts/public-browser.test.cjs",
    "test:public-production": "node scripts/public-production-smoke.cjs",
    "test:public-refinement": "node scripts/public-home-correction.test.cjs",
    "test:public-polish": "node scripts/public-polish-browser.test.cjs",
    "test:pricing-billing": "node scripts/pricing-billing.test.cjs",
    "test:campaign-premium": "node scripts/campaign-premium.test.cjs",
    "test:assistant": "node scripts/assistant-operating.test.cjs && node scripts/assistant-production-connectivity-check.test.mjs && npm run test:assistant-workspace",
    "test:ai-pricing": "node scripts/ai-pricing.test.cjs",
    "test:ai-usage-db": "node scripts/ai-usage-database.test.cjs",
    "test:assistant-browser": "node scripts/assistant-browser.test.cjs",
    "test:assistant-messaging": "node scripts/assistant-messaging.test.cjs && node scripts/assistant-messaging-safety.test.cjs && node scripts/assistant-repair.test.cjs",
    "test:assistant-roots-db": "node scripts/assistant-roots-database.test.cjs",
    "test:assistant-messaging-browser": "node scripts/assistant-messaging-browser.test.cjs",
    "test:concierge": "node scripts/concierge.test.cjs",
    "test:concierge-db": "node scripts/concierge-database.test.cjs",
    "test:concierge-browser": "node scripts/concierge-browser.test.cjs",
    "test:assistant-workspace": "node scripts/assistant-workspace.test.cjs",
    "test:assistant-workspace-browser": "node scripts/assistant-workspace-browser.test.cjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "@clerk/ui": "^1.25.7",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.2.6",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "utf-8-validate": "^5.0.10"
  }
}
