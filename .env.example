# ===== Clerk =====
# Paste FULL keys from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_paste_full_publishable_key_here
CLERK_SECRET_KEY=sk_test_paste_full_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_server_only
SUPABASE_STORAGE_BUCKET=voice-assets

# ===== Provider adapter =====
# Active provider used when a campaign doesn't override it. Options: mock | slybroadcast | twilio
VOICE_PROVIDER=mock
VOICE_PROVIDER_FROM_NUMBER=+14075550100

# --- Slybroadcast (ringless voicemail) ---
SLYBROADCAST_USERNAME=
SLYBROADCAST_PASSWORD=
SLYBROADCAST_CALLER_ID=

# --- Twilio (SMS; voicemail via TwiML) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== Campaign runner (cron) =====
# Used by external schedulers hitting /api/campaigns/runner with header `x-cron-secret`.
CAMPAIGN_RUNNER_SECRET=change_me_random_long_string

# ===== AI providers (optional — falls back to template generator) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== App =====
APP_BASE_URL=http://localhost:3000
