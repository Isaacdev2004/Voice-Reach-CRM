# ===== Clerk =====
# Paste FULL keys from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_paste_full_publishable_key_here
CLERK_SECRET_KEY=sk_test_paste_full_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_server_only
SUPABASE_STORAGE_BUCKET=voice-assets

# ===== Provider adapter =====
# Active provider used when a campaign doesn't override it. Options: mock | slybroadcast | twilio
VOICE_PROVIDER=slybroadcast
VOICE_PROVIDER_FROM_NUMBER=+14075550100

# --- Slybroadcast (ringless voicemail) ---
SLYBROADCAST_USERNAME=
SLYBROADCAST_PASSWORD=
SLYBROADCAST_CALLER_ID=
# Optional. Defaults to {APP_BASE_URL}/api/webhooks/voice?provider=slybroadcast
SLYBROADCAST_DISPO_URL=

# --- Twilio (SMS; voicemail via TwiML) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===== Campaign runner (cron) =====
# Used by external schedulers hitting /api/campaigns/runner with header `x-cron-secret`.
CAMPAIGN_RUNNER_SECRET=change_me_random_long_string
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
CRON_SECRET=

# ===== AI providers (optional — falls back to template generator) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== Dotloop (transaction docs OAuth) =====
# Redirect URI to register: {APP_BASE_URL}/api/integrations/dotloop/callback
DOTLOOP_CLIENT_ID=
DOTLOOP_CLIENT_SECRET=

# --- ElevenLabs (AI voice / script-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== App =====
APP_BASE_URL=http://localhost:3000

# ===== Stripe (membership checkout) =====
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional — if you create Products/Prices in Stripe Dashboard:
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_PRO=price_...
# Starter PAYG (SMS $0.03 / RVM $0.10) is billed via Stripe invoice items on each live send —
# no extra price IDs required. Charges appear on the customer's next subscription invoice.
